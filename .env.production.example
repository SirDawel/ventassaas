# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ============================================
# Copia este archivo como .env en el servidor de producción

# ============================================
# DJANGO CORE
# ============================================
SECRET_KEY=GENERA-UNA-CLAVE-SEGURA-AQUI
ENVIRONMENT=production
DEBUG=False
ALLOWED_HOSTS=colegiocced.online,www.colegiocced.online

# ============================================
# BASE DE DATOS (PostgreSQL recomendado)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=escuela_db
DB_USER=escuela_user
DB_PASSWORD=password_seguro_aqui
DB_HOST=localhost
DB_PORT=5432

# ============================================
# EMAIL
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_token_aqui
DEFAULT_FROM_EMAIL=tu_email@gmail.com
SITE_URL=colegiocced.online

# ============================================
# INFORMACIÓN DE LA ESCUELA
# ============================================
ESCUELA_NOMBRE=Centro Cristiano de Educación para el Desarrollo
ESCUELA_RNC=123-45678-9
ESCUELA_TELEFONO=(809) 555-1234
ESCUELA_DIRECCION=Calle Pedro Henrriquez Ureña #123, San Juan de la Maguana, República Dominicana
ESCUELA_EMAIL=info@escuela.edu.do

# ============================================
# SESIÓN
# ============================================
SESSION_COOKIE_AGE=14400
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_SAVE_EVERY_REQUEST=False
