# Django
SECRET_KEY=change_me
ENVIRONMENT=production
DEBUG=False
ALLOWED_HOSTS=.tudominio.com,tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://*.tudominio.com

# Base de datos RDS PostgreSQL
DB_NAME=ventas
DB_USER=ventas_user
DB_PASSWORD=change_me
DB_HOST=ventas-db.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432

# Redis (ElastiCache)
CELERY_BROKER_URL=redis://ventas-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_URL=tudominio.com

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=False
STRIPE_SUCCESS_URL=https://tudominio.com/suscripcion/pago-exitoso/
STRIPE_CANCEL_URL=https://tudominio.com/suscripcion/planes/
STRIPE_CURRENCY=usd

# Seguridad
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
SECURITY_ALERTS_ENABLED=True
SECURITY_ALERT_EMAIL_RECIPIENTS=admin@tudominio.com
REQUIRE_2FA_FOR_ROLES=Administrador,Director
