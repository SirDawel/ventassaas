# ============================================
# CONFIGURACIÓN PARA POS FÍSICOS
# ============================================

# Proveedor de pago principal: 'cardnet' o 'azul'
PAYMENT_PROVIDER=cardnet

# ============================================
# CREDENCIALES CARDNET
# ============================================
CARDNET_API_KEY=tu_api_key_aqui
CARDNET_MERCHANT_ID=tu_merchant_id_aqui
CARDNET_WEBHOOK_SECRET=tu_webhook_secret_aqui
CARDNET_API_URL=https://sandbox.cardnet.com.do/api

# Para producción, cambia a:
# CARDNET_API_URL=https://api.cardnet.com.do/api

# ============================================
# CREDENCIALES AZUL
# ============================================
AZUL_USER=tu_usuario_aqui
AZUL_PASSWORD=tu_password_aqui
AZUL_STORE_ID=tu_store_id_aqui
AZUL_WEBHOOK_SECRET=tu_webhook_secret_aqui
AZUL_API_URL=https://sandbox.azul.com.do

# Para producción, cambia a:
# AZUL_API_URL=https://pagos.azul.com.do

# ============================================
# CONFIGURACIÓN DE IMPRESORA POS
# ============================================

# Habilitar impresión automática de facturas
AUTO_PRINT_INVOICES=True

# Configuración de impresora térmica
POS_PRINTER_ENABLED=True
POS_PRINTER_TYPE=network  # network, usb, o file
POS_PRINTER_NAME=EPSON_TM_T88

# Para impresora en red (network)
POS_PRINTER_IP=192.168.1.100
POS_PRINTER_PORT=9100

# Para impresora USB (usb)
POS_PRINTER_VENDOR_ID=0x04b8
POS_PRINTER_PRODUCT_ID=0x0e15

# Para impresión a archivo (file) - solo para pruebas
POS_PRINTER_PATH=/tmp/receipt.txt

# ============================================
# CONFIGURACIÓN DE EMAIL
# ============================================

# Enviar factura por email automáticamente
AUTO_EMAIL_INVOICES=True

# ============================================
# NOTAS PARA CONFIGURACIÓN
# ============================================

# 1. OBTENER CREDENCIALES:
#    - Cardnet: Solicita acceso en https://www.cardnet.com.do/comercios
#    - Azul: Solicita acceso en https://www.azul.com.do/comercios

# 2. CONFIGURAR WEBHOOKS:
#    - El webhook debe apuntar a: https://tu-dominio.com/webhooks/pos/cardnet/
#    - O para Azul: https://tu-dominio.com/webhooks/pos/azul/
#    - DEBE ser HTTPS (no HTTP)
#    - El proveedor te dará un WEBHOOK_SECRET para validar las notificaciones

# 3. INSTALAR LIBRERÍA DE IMPRESORA (opcional):
#    pip install python-escpos
#    pip install reportlab  # Para generar PDFs

# 4. PRUEBAS:
#    - Usa las URLs de sandbox para pruebas
#    - Una vez todo funcione, cambia a URLs de producción
#    - Usa un terminal de prueba proporcionado por el proveedor

# 5. ASOCIAR TERMINALES CON ESTUDIANTES:
#    - Opción 1: Configurar en el panel de Cardnet/Azul que el terminal
#      envíe la cédula del estudiante en custom_field_1
#    - Opción 2: Usar el modelo TerminalEstudiante en el admin de Django
#      para asociar cada terminal con un estudiante específico
