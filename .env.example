# ============================================
# ARCHIVO .ENV (PLANTILLA)
# ============================================
# Copia este archivo a .env en cada servidor y ajusta los valores según el dominio

SECRET_KEY=coloca_aqui_tu_secret_key
ENVIRONMENT=production
DEBUG=False

# Dominio por servidor
# Servidor 1 (colegiocced.online):
# ALLOWED_HOSTS=colegiocced.online,www.colegiocced.online
# CSRF_TRUSTED_ORIGINS=https://colegiocced.online,https://www.colegiocced.online
#
# Servidor 2 (eduhatodelpadre.online):
# ALLOWED_HOSTS=eduhatodelpadre.online,www.eduhatodelpadre.online
# CSRF_TRUSTED_ORIGINS=https://eduhatodelpadre.online,https://www.eduhatodelpadre.online
#
# Desarrollo local:
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Base de datos PostgreSQL
DB_NAME=escuelaonline
DB_USER=djdawel
DB_PASSWORD=coloca_aqui_tu_password
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_URL=127.0.0.1:8000

# Sesión
SESSION_COOKIE_AGE=14400
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_SAVE_EVERY_REQUEST=True

# Tiempos de sesión por rol (en segundos) - Opcional
# El middleware RoleBasedSessionMiddleware usa estos valores
# Si no están definidos, usa los valores predeterminados:
# Administrador/Director: 3600 (1 hora)
# Profesor/Coordinador/Psicologo/Bibliotecario: 10800 (3 horas)
# Estudiante: 14400 (4 horas)
# Secretaria/Otro: 7200 (2 horas)
#
# Para personalizar, descomenta y ajusta:
# SESSION_TIMEOUT_ADMINISTRADOR=3600
# SESSION_TIMEOUT_DIRECTOR=3600
# SESSION_TIMEOUT_SECRETARIA=7200
# SESSION_TIMEOUT_COORDINADOR=7200
# SESSION_TIMEOUT_PROFESOR=10800
# SESSION_TIMEOUT_PSICOLOGO=10800
# SESSION_TIMEOUT_BIBLIOTECARIO=10800
# SESSION_TIMEOUT_ESTUDIANTE=14400
# SESSION_TIMEOUT_OTRO=7200

# ============================================
# SEGURIDAD AVANZADA
# ============================================

# Google reCAPTCHA v2 (obtener en https://www.google.com/recaptcha/admin)
# Las claves por defecto son de testing. Reemplaza con tus claves reales en producción.
RECAPTCHA_PUBLIC_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_PRIVATE_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Deshabilitar CAPTCHA en desarrollo (opcional)
DISABLE_CAPTCHA_IN_DEV=False

# Configuración de bloqueo de cuentas
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Alertas de seguridad
SECURITY_ALERTS_ENABLED=True
SECURITY_ALERT_EMAIL_RECIPIENTS=admin@ejemplo.com

# 2FA obligatorio para roles específicos (separados por coma)
REQUIRE_2FA_FOR_ROLES=Administrador,Director

# Limpieza automática de datos antiguos (en días)
AUTO_CLEANUP_SESSIONS_DAYS=30
AUTO_CLEANUP_LOGS_DAYS=90

# NOTA: La información de la escuela (nombre, RNC, dirección, etc.)
# se maneja ahora desde el módulo "Configuración" en la aplicación web.
