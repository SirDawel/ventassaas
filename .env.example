# ============================================
# CONFIGURACIÓN DEL PROYECTO - EJEMPLO
# ============================================
# Copia este archivo como .env y completa los valores

# ============================================
# DJANGO CORE
# ============================================
# Genera un SECRET_KEY único con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CAMBIAR-ESTO-POR-UNA-CLAVE-SEGURA-Y-UNICA

# Entorno: development o production
ENVIRONMENT=development

# Debug mode (True en desarrollo, False en producción)
DEBUG=True

# Hosts permitidos (separados por coma)
# Ejemplo: localhost,127.0.0.1,tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# BASE DE DATOS
# ============================================
# Para desarrollo (SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Para producción (PostgreSQL) - descomentar y configurar
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=escuela_db
# DB_USER=escuela_user
# DB_PASSWORD=tu_password_seguro
# DB_HOST=localhost
# DB_PORT=5432

# ============================================
# EMAIL
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_password_o_app_token
DEFAULT_FROM_EMAIL=tu_email@gmail.com

# URL del sitio (sin http://)
SITE_URL=127.0.0.1:8000

# ============================================
# INFORMACIÓN DE LA ESCUELA
# ============================================
ESCUELA_NOMBRE=Centro Cristiano de Educación para el Desarrollo
ESCUELA_RNC=123-45678-9
ESCUELA_TELEFONO=(809) 555-1234
ESCUELA_DIRECCION=Calle Pedro Henrriquez Ureña #123, San Juan de la Maguana, República Dominicana
ESCUELA_EMAIL=info@escuela.edu.do

# ============================================
# SESIÓN
# ============================================
SESSION_COOKIE_AGE=300
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
