# Systemd service file for Celery Beat Scheduler
# /etc/systemd/system/celery-beat.service

[Unit]
Description=Celery Beat Scheduler Service
After=network.target postgresql.service redis.service celery-worker.service
Wants=redis.service celery-worker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/ventas
Environment="PATH=/var/www/ventas/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DJANGO_SETTINGS_MODULE=VentasSys.settings"

# Celery beat command
ExecStart=/var/www/ventas/.venv/bin/celery -A VentasSys beat --loglevel=info --logfile=/var/log/celery/beat.log --schedule=/var/www/ventas/celerybeat-schedule

# Restart policy
Restart=always
RestartSec=10s

# Security
PrivateTmp=true
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=celery-beat

[Install]
WantedBy=multi-user.target
